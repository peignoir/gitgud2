# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# YC Mentor Guide (upload your guide to OpenAI Files first)
YC_MENTOR_FILE_ID=file-xxxxx

# Memory & Search APIs
MEM0_API_KEY=your-mem0-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Optional: User identifier for memory isolation
USER_ID=demo_user

# Optional: Reuse existing vector store (cached daily by default)
# YC_MENTOR_VECTOR_STORE_ID=vs_xxxxx

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend Configuration (for production build)
VITE_API_URL=https://your-heroku-app.herokuapp.com
